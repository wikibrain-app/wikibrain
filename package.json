{
  "name": "wikibrain",
  "version": "0.2.0",
  "private": true,
  "description": "WikiBrain - a hosted LLM wiki: a Markdown knowledge base with a built-in MCP server",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.build.json && tsx --tsconfig web/tsconfig.json scripts/prerender-help.tsx",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed-dev.ts",
    "keys:rotate": "tsx src/rotate-keys.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "smoke:prod": "node --import tsx --test test/smoke-prod.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@marp-team/marp-core": "^4.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "katex": "^0.18.5",
    "mammoth": "^1.12.2",
    "mermaid": "^11.17.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.10.1",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "pptxgenjs": "^3.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}

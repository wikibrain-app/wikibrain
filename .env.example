# Copy to .env for local development. In production set the same names in your
# platform's environment or secret store. Everything outside "Required" is optional.

# ── Required ──

# PostgreSQL 16 or newer.
DATABASE_URL=postgres://localhost:5432/wikibrain

# The public URL users type in the browser. Session cookies, verification links,
# the OAuth issuer and the prerendered pages' canonical URLs all come from it.
APP_URL=http://localhost:3000

# Signs sessions: openssl rand -hex 32
BETTER_AUTH_SECRET=change_me

# Encrypts users' stored provider keys. Must differ from BETTER_AUTH_SECRET, and is
# required when NODE_ENV=production. Prefer the _FILE form so the key never appears in
# the environment. After changing it, re-encrypt with npm run keys:rotate
# (node dist/rotate-keys.js inside a container).
KEY_ENCRYPTION_SECRET=
# KEY_ENCRYPTION_SECRET_FILE=/run/secrets/wikibrain_key

# ── Server ──

PORT=3000
# Concurrent database connections. Raise it for a busy instance, keeping well under the server's max_connections.
PG_POOL_MAX=20
# Extra browser origins allowed to call the API, comma separated.
TRUSTED_ORIGINS=
# Per-minute limits: MCP calls per token, requests per IP, REST API calls per IP.
MCP_RATE_PER_MIN=120
IP_RATE_PER_MIN=300
API_RATE_PER_MIN=1500
# Shown on /healthz and in the page footer; some platforms inject their own variable.
# GIT_COMMIT=
# Addresses whose page views are never counted (comma separated), on top of the /?noanalytics=1 opt-out.
ANALYTICS_IGNORE_IPS=

# ── Sign-in and e-mail ──

# Google sign-in needs both. Redirect URI: APP_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Without a mail API key, verification and password-reset links are printed to the
# server log. The sender's domain has to be verified with the mail provider.
RESEND_API_KEY=
MAIL_FROM=WikiBrain <no-reply@example.com>

# ── Import and agents ──

# Headless-browser fallback for pages that need JavaScript. Set 0 to disable.
IMPORT_HEADLESS=1
# Pages rendered at the same time. Each one costs roughly 275 MB of browser memory, so raise this only if the
# host has the headroom. HEADLESS_PER_KEY is the share any single workspace may hold while others are waiting,
# and requests beyond HEADLESS_QUEUE_MAX are refused with 429 instead of queueing indefinitely.
HEADLESS_CONCURRENCY=3
HEADLESS_PER_KEY=1
HEADLESS_QUEUE_MAX=24
# Tool calls a single agent run may make.
INGEST_MAX_STEPS=60
# Items fetched per Zotero sync round.
ZOTERO_ITEMS_PER_RUN=200

# ── Quotas ──
# Ceilings applied to accounts on the free plan. A single-tenant instance usually
# wants them raised; the paid-plan ceilings use PRO_ instead of FREE_.
FREE_RUNS_PER_MONTH=20
FREE_NOTES_LIMIT=200
FREE_STORAGE_BYTES=20971520
FREE_TOKENS_LIMIT=1
FREE_RETENTION_DAYS=7

# ── Local development only (npm run db:seed) ──
# Creates a verified account and an MCP token whose plaintext stays here for mcp.json.
DEV_EMAIL=dev@example.com
DEV_PASSWORD=devpass123
DEV_MCP_TOKEN=wb_live_change_me
